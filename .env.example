# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Redis Database Configuration
# For local development: redis://localhost:6379
# For Railway: will be provided automatically when Redis service is added
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=INFO

# Optional Configuration
DOWNLOAD_PATH=downloads
DLQ_RETRY_INTERVAL=3600  # Retry failed downloads every hour (in seconds)
CLEANUP_INTERVAL=36000   # Clean downloads folder every 10 hours (in seconds)
